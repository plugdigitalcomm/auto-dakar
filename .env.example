# --- Base de données (Supabase PostgreSQL — uniquement la DB, pas l'auth/storage Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/auto_dakar?schema=public"

# --- NextAuth (authentification admin, Credentials provider) ---
# Générer une valeur avec : openssl rand -base64 32
NEXTAUTH_SECRET="changeme"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (stockage et optimisation images/vidéos) ---
CLOUDINARY_CLOUD_NAME="changeme"
CLOUDINARY_API_KEY="changeme"
CLOUDINARY_API_SECRET="changeme"

# --- Compte admin initial (utilisé uniquement par le script de seed) ---
ADMIN_EMAIL="admin@autodakar.sn"
ADMIN_PASSWORD="changeme"
